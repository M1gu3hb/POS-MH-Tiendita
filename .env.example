# Supabase
# URL publica del proyecto Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# Llave anon/publica de Supabase para cliente y SSR.
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Llave service role para API routes y webhooks. Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Stripe (activar cuando estes listo)
# Llave secreta live de Stripe para API routes server-side.
STRIPE_SECRET_KEY=sk_live_...
# Price ID mensual de la suscripcion.
STRIPE_PRICE_ID_MONTHLY=price_...
# Secreto del endpoint de webhook de Stripe.
STRIPE_WEBHOOK_SECRET=whsec_...
# Llave publica live de Stripe para el cliente.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# App
# URL publica final del deployment en Vercel.
NEXT_PUBLIC_APP_URL=https://tu-dominio.vercel.app
